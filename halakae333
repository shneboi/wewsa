	local function updatePartnerUI(targetPlayer)
		if currentPartner == targetPlayer then return end
		currentPartner = targetPlayer
		if targetPlayer then
			hasTradePartner = true
			local bountyStr = getPartnerBounty(targetPlayer)
			if bountyStr then
				partnerNameLabel.Text = targetPlayer.DisplayName .. "  •  ⚓ " .. bountyStr
			else
				partnerNameLabel.Text = targetPlayer.DisplayName
			end
			partnerNameLabel.TextColor3 = COLORS.GlowWhite
			infoBoxBorder.Color = COLORS.GlowWhite
			infoBoxBorder.Transparency = 0.1
			
			avatarIcon.Image = "rbxasset://textures/ui/common/loading.png"
			task.spawn(function()
				local success, content = pcall(function()
					return playersService:GetUserThumbnailAsync(
						targetPlayer.UserId, 
						Enum.ThumbnailType.HeadShot, 
						Enum.ThumbnailSize.Size48x48
					)
				end)
				if success and content then
					avatarIcon.Image = content
					avatarGlow.Color = COLORS.GlowWhite
					avatarGlow.Transparency = 0.1
				else
					avatarIcon.Image = "rbxasset://textures/ui/common/avatar.png"
					avatarGlow.Color = COLORS.BorderSoft
				end
			end)
			showNotification("Trade Partner Detected: " .. targetPlayer.DisplayName, false)
			if notifBadge then notifBadge.Visible = true end
		else
			hasTradePartner = false
			partnerNameLabel.Text = "None (Sit at trade table)"
			partnerNameLabel.TextColor3 = COLORS.TextSecondary
			infoBoxBorder.Color = COLORS.BorderSoft
			infoBoxBorder.Transparency = 0.5
			avatarIcon.Image = "rbxasset://textures/ui/common/avatar.png"
			avatarGlow.Color = COLORS.BorderSoft
			if notifBadge then notifBadge.Visible = false end
		end
	end
	local function detectTradePartner()
		local myChar = player.Character
		if not myChar then return nil end
		local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
		local myHum = myChar:FindFirstChildOfClass("Humanoid")
		if not myRoot or not myHum then return nil end
		local mainGui = playerGui:FindFirstChild("Main")
		if mainGui then
			local tradeGui = mainGui:FindFirstChild("Trade")
			if tradeGui and tradeGui.Visible then
				for _, obj in ipairs(tradeGui:GetDescendants()) do
					if obj:IsA("TextLabel") and obj.Visible and obj.Text ~= "" and obj.Text ~= player.Name and obj.Text ~= player.DisplayName then
						for _, p in ipairs(playersService:GetPlayers()) do
							if p ~= player then
								if obj.Text == p.Name or obj.Text == p.DisplayName or obj.Text:find(p.DisplayName, 1, true) or obj.Text:find(p.Name, 1, true) then
									return p
								end
							end
						end
					end
				end
			end
		end
		if myHum.Sit then
			local closestPlr = nil
			local closestDist = 18
			for _, otherPlr in ipairs(playersService:GetPlayers()) do
				if otherPlr ~= player and otherPlr.Character then
					local otherRoot = otherPlr.Character:FindFirstChild("HumanoidRootPart") or otherPlr.Character:FindFirstChild("Torso")
					local otherHum = otherPlr.Character:FindFirstChildOfClass("Humanoid")
					if otherRoot and otherHum then
						local dist = (otherRoot.Position - myRoot.Position).Magnitude
						if dist <= closestDist and (otherHum.Sit or dist <= 12) then
							closestDist = dist
							closestPlr = otherPlr
						end
					end
				end
			end
			if closestPlr then
				return closestPlr
			end
		end
		return nil
	end
	task.spawn(function()
		while gui and gui.Parent do
			pcall(function()
				local foundPartner = detectTradePartner()
				updatePartnerUI(foundPartner)
			end)
			task.wait(0.4)
		end
	end)
