	-- Function para hanapin ang katapat na upuan sa trade table
	local function getTradeSeatPartner()
		local character = player.Character
		if not character then return nil end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or not humanoid.SeatPart then return nil end
		
		local mySeat = humanoid.SeatPart
		
		-- 1. Check kung nasa parehong trade table model ang kabilang upuan
		local parentModel = mySeat.Parent
		if parentModel then
			for _, item in ipairs(parentModel:GetDescendants()) do
				if item:IsA("Seat") and item ~= mySeat and item.Occupant then
					local otherChar = item.Occupant.Parent
					local otherPlr = playersService:GetPlayerFromCharacter(otherChar)
					if otherPlr then return otherPlr end
				end
			end
		end

		-- 2. Nearby check sa kabilang seat (distansya na 14 studs - lapad ng table)
		for _, otherPlr in ipairs(playersService:GetPlayers()) do
			if otherPlr ~= player and otherPlr.Character then
				local otherHum = otherPlr.Character:FindFirstChildOfClass("Humanoid")
				if otherHum and otherHum.SeatPart and otherHum.SeatPart ~= mySeat then
					local dist = (otherHum.SeatPart.Position - mySeat.Position).Magnitude
					if dist <= 14 then
						return otherPlr
					end
				end
			end
		end

		return nil
	end

