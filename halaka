	minimizedIcon.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	
	userInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			minimizedIcon.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	
	-- Hover effect
	minimizedIcon.MouseEnter:Connect(function()
		tweenService:Create(minimizedIcon, TweenInfo.new(0.2), {Size = UDim2.new(0, 55, 0, 55)}):Play()
		tweenService:Create(iconBorder, TweenInfo.new(0.2), {Transparency = 0, Thickness = 3}):Play()
	end)
	
	minimizedIcon.MouseLeave:Connect(function()
		tweenService:Create(minimizedIcon, TweenInfo.new(0.2), {Size = UDim2.new(0, 50, 0, 50)}):Play()
		tweenService:Create(iconBorder, TweenInfo.new(0.2), {Transparency = 0.3, Thickness = 2}):Play()
	end)
	
	-- Minimize function
	minimizeBtn.MouseButton1Click:Connect(function()
		tweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}):Play()
		
		task.wait(0.2)
		mainFrame.Visible = false
		
		minimizedIcon.Visible = true
		minimizedIcon.Size = UDim2.new(0, 0, 0, 0)
		
		tweenService:Create(minimizedIcon, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 50, 0, 50)
		}):Play()
	end)
	
	-- Restore function
	minimizedIcon.MouseButton1Click:Connect(function()
		tweenService:Create(minimizedIcon, TweenInfo.new(0.2), {
			Size = UDim2.new(0, 0, 0, 0)
		}):Play()
		
		task.wait(0.2)
		minimizedIcon.Visible = false
		
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 0, 0, 0)
		mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
		
		tweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, mainWidth, 0, mainHeight),
			Position = UDim2.new(0.5, -mainWidth/2, 0.5, -mainHeight/2)
		}):Play()
	end)
	
	-- Exit button
	exitBtn.MouseButton1Click:Connect(function()
		tweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}):Play()
		task.wait(0.3)
		gui:Destroy()
	end)

	local function addHoverEffect(btn)
		btn.MouseEnter:Connect(function()
			tweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = COLORS.Surface:lerp(COLORS.Border, 0.2)}):Play()
		end)
		btn.MouseLeave:Connect(function()
			tweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = COLORS.Surface}):Play()
		end)
	end

	addHoverEffect(minimizeBtn)

	-- Entry Animation
	mainFrame.Size = UDim2.new(0, 0, 0, 0)
	mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	local entryTween = TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	tweenService:Create(mainFrame, entryTween, {Size = UDim2.new(0, mainWidth, 0, mainHeight)}):Play()
	tweenService:Create(mainFrame, entryTween, {Position = UDim2.new(0.5, -mainWidth/2, 0.5, -mainHeight/2)}):Play()
	
	makeAlwaysOnTop(mainFrame)
	makeAlwaysOnTop(minimizedIcon)
end

showMainUI()

