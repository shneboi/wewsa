local function createParticles(parent)
    local particleCount = isMobile and 8 or 20
    
    for i = 1, particleCount do
        local particle = Instance.new("Frame")
        particle.Size = UDim2.new(0, isMobile and 3 or 4, 0, isMobile and 3 or 4)
        particle.Position = UDim2.new(math.random(), 0, math.random(), 0)
        particle.BackgroundColor3 = COLORS.Border
        particle.BackgroundTransparency = 0.3
        particle.BorderSizePixel = 0
        particle.ZIndex = 9998
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = particle
        particle.Parent = parent
        
        coroutine.wrap(function()
            local speed = math.random(10, 25) / 10
            local angle = math.random() * math.pi * 2
            local moveX = math.cos(angle) * 0.002 * speed
            local moveY = math.sin(angle) * 0.002 * speed
            
            while particle and particle.Parent do
                local newX = particle.Position.X.Scale + moveX
                local newY = particle.Position.Y.Scale + moveY
                
                if newX < 0 then newX = 1
                elseif newX > 1 then newX = 0 end
                if newY < 0 then newY = 1
                elseif newY > 1 then newY = 0 end
                
                particle.Position = UDim2.new(newX, 0, newY, 0)
                runService.RenderStepped:Wait()
            end
        end)()
    end
end

