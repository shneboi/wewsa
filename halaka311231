local function shortFlags(inst)
	local f = {}
	if inst:FindFirstChildOfClass("Humanoid") then f[#f+1] = "Hum" end
	if inst:FindFirstChildWhichIsA("ClickDetector", true) then f[#f+1] = "Click" end
