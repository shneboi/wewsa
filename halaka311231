local PUMPKIN_FLY_SPEED = 100                     -- studs/sec (ibaba mo kung na-kick o na-rubberband)
local PUMPKIN_HOVER_OFFSET = Vector3.new(0, 3, 0) -- lumilipad sa ibabaw ng pumpkin
local PUMPKIN_ATTACK_RANGE = 12
local PUMPKIN_SCAN_RANGE = math.huge          -- buong mapa
local PUMPKIN_FAR_SPEED = 350                  -- bilis kapag malayo
local PUMPKIN_FAR_DISTANCE = 150               -- lampas dito = FAR_SPEED

local PUMPKIN_ATTACK_TIMEOUT = 5              -- segundo; kapag walang HP at hindi pa rin nawawala = i-skip
local PUMPKIN_MAX_SIZE = 25                    -- sobrang laki = container, hindi pumpkin

local pumpkinBlacklist = {}                    -- mga pumpkin na na-skip (hindi namamatay)
local pumpkinTarget = nil
local lastPumpkinScan = 0

local function isMeleeTool(tool)
	return tool:IsA("Tool") and tool.ToolTip == "Melee"
end

local function isOtherTool(tool)
	-- fallback: kahit anong tool na hindi Fruit/Sword/Gun
	return tool:IsA("Tool") and tool.ToolTip ~= "Blox Fruit" and tool.ToolTip ~= "Sword"
		and tool.ToolTip ~= "Gun" and not tool.Name:find("Fruit")
end

local function equipMelee()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end

	-- Kung may naka-equip nang melee, yun na
	for _, t in ipairs(char:GetChildren()) do
		if isMeleeTool(t) then return t end
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		-- Unahin ang tunay na Melee
		for _, t in ipairs(backpack:GetChildren()) do
			if isMeleeTool(t) then
				hum:EquipTool(t)
				return t
			end
		end
		-- Fallback
		for _, t in ipairs(backpack:GetChildren()) do
			if isOtherTool(t) then
				hum:EquipTool(t)
				return t
			end
		end
	end
	return nil
end

-- HP ng model: Humanoid, o Attribute/Value na Health/HP. nil = walang HP
local function getHP(model)
	if not model then return nil end
	local h = model:FindFirstChildOfClass("Humanoid")
	if h then return h.Health end
	for _, key in ipairs({"Health", "HP", "health", "hp"}) do
		local attr = model:GetAttribute(key)
		if type(attr) == "number" then return attr end
		local v = model:FindFirstChild(key)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then return v.Value end
	end
	return nil
end

-- Buhay pa ang target? May HP -> HP > 0. Walang HP -> basta nandoon pa at hindi na-skip
local function isTargetAlive(part)
	if not part or not part.Parent or not part:IsDescendantOf(workspace) then return false end
	if pumpkinBlacklist[part] then return false end
	local hp = getHP(part:FindFirstAncestorOfClass("Model"))
	if hp ~= nil then return hp > 0 end
	return true
end

local function nameMatches(inst)
	local n = string.lower(inst.Name)
	return string.find(n, "pumpkin") ~= nil or string.find(n, "jack") ~= nil
end

-- Lahat ng pumpkin (may HP man o wala). Binabalik: {inst, part, dist, hp, skipped}
local function collectPumpkins(root, char)
	local list = {}
	for _, o in ipairs(workspace:GetDescendants()) do
		if (o:IsA("Model") or o:IsA("BasePart")) and nameMatches(o)
			and not o:IsDescendantOf(char)
			and not (o:IsA("Model") and playersService:GetPlayerFromCharacter(o)) then

			-- Kung part ito ng pumpkin na Model, yung Model na ang bibilangin
			local parentModel = o:FindFirstAncestorOfClass("Model")
			local insideMatchedModel = o:IsA("BasePart") and parentModel and nameMatches(parentModel)

			if not insideMatchedModel then
				local part, size
				if o:IsA("Model") then
					part = o:FindFirstChild("HumanoidRootPart") or o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true)
					local ok, ext = pcall(function() return o:GetExtentsSize() end)
					size = ok and ext.Magnitude or 0
				else
					part = o
					size = o.Size.Magnitude
				end

				if part and size <= PUMPKIN_MAX_SIZE then
					local hp = o:IsA("Model") and getHP(o) or nil
					if not (hp and hp <= 0) then
						list[#list+1] = {
							inst = o,
							part = part,
							dist = (part.Position - root.Position).Magnitude,
							hp = hp,
							skipped = pumpkinBlacklist[part] == true,
						}
					end
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end

local function getNearestPumpkin()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	for _, e in ipairs(collectPumpkins(root, char)) do
		if not e.skipped and e.dist <= PUMPKIN_SCAN_RANGE then
			return e.part
		end
	end
	return nil
end

-- 🔎 DEBUG: ilista ang pinakamalapit na pumpkin-named objects at ang "flags" nila
local lastDebugPrint = 0
local function describePumpkin(inst, dist)
	local flags = {}
	if inst:FindFirstChildOfClass("Humanoid") then flags[#flags+1] = "Humanoid" end
	if inst:FindFirstChildWhichIsA("ClickDetector", true) then flags[#flags+1] = "ClickDetector" end
	if inst:FindFirstChildWhichIsA("ProximityPrompt", true) then flags[#flags+1] = "ProximityPrompt" end
	if inst:FindFirstChildWhichIsA("TouchTransmitter", true) then flags[#flags+1] = "Touch" end
	for k, _ in pairs(inst:GetAttributes()) do flags[#flags+1] = "attr:" .. k end
	local kids = {}
	for i, c in ipairs(inst:GetChildren()) do
		if i > 6 then break end
		kids[#kids+1] = c.Name .. ":" .. c.ClassName
	end
	return string.format("%s [%s] %d studs | %s | flags=%s | kids=%s",
		inst.Name, inst.ClassName, dist, inst:GetFullName(),
		table.concat(flags, ","), table.concat(kids, ","))
end

local function reportNoPumpkin()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local list = {}
	for _, o in ipairs(workspace:GetDescendants()) do
		if (o:IsA("Model") or o:IsA("BasePart")) and nameMatches(o) and not o:IsDescendantOf(char) then
			local pos = o:IsA("Model") and o:GetPivot().Position or o.Position
			list[#list+1] = {inst = o, dist = (pos - root.Position).Magnitude}
		end
	end
	table.sort(list, function(x, y) return x.dist < y.dist end)

	if tick() - lastDebugPrint > 15 then
		lastDebugPrint = tick()
		print("[PumpkinDebug] total pumpkin-named: " .. #list)
		for i = 1, math.min(6, #list) do
			print("[PumpkinDebug] " .. describePumpkin(list[i].inst, math.floor(list[i].dist)))
		end
	end

	if list[1] then
		local near = list[1].inst
		showNotification("Walang attackable. Pinakamalapit: " .. near.Name .. " [" .. near.ClassName .. "] (check console)", true)
	else
		showNotification("Walang pumpkin-named object na na-load sa client mo", true)
	end
end

