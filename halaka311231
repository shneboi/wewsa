-- ✈️ FLY loop: lumilipad papunta sa pumpkin
local lastNoTargetNotice = 0

local function flyStep(dt)
	if trickTreatEnabled then return end -- Trick or Treat ang may hawak ng galaw
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then return end

	-- Noclip para hindi tumama sa pader habang lumilipad
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = false end
	end

	-- Panatilihing nakalutang (walang gravity pull)
	local bv = root:FindFirstChild("PumpkinFly")
	if not bv then
		bv = Instance.new("BodyVelocity")
		bv.Name = "PumpkinFly"
		bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bv.Parent = root
	end
	bv.Velocity = Vector3.zero
	root.AssemblyLinearVelocity = Vector3.zero

	-- Maghanap ng target (once per second, o kapag nawala na yung dati)
	if not isTargetAlive(pumpkinTarget) and (tick() - lastPumpkinScan > 0.3) then
		local found = getNearestPumpkin()
		lastPumpkinScan = tick()
		if found ~= pumpkinTarget then
			pumpkinTarget = found
			if found then
				task.spawn(showNotification, "Target: " .. found:GetFullName():sub(-40), false)
			end
		end
	end

	if not isTargetAlive(pumpkinTarget) then
		pumpkinTarget = nil
		if tick() - lastNoTargetNotice > 4 then
			lastNoTargetNotice = tick()
			task.spawn(reportNoPumpkin)
		end
		return
	end

	local goal = pumpkinTarget.Position + PUMPKIN_HOVER_OFFSET
	local diff = goal - root.Position
	local dist = diff.Magnitude
	local newPos = root.Position
	if dist > 0.5 then
		local speed = (dist > PUMPKIN_FAR_DISTANCE) and PUMPKIN_FAR_SPEED or PUMPKIN_FLY_SPEED
		newPos = root.Position + diff.Unit * math.min(speed * dt, dist)
	end

	-- Humarap sa pumpkin (iwas error kapag eksaktong nasa ibabaw)
	local lookTarget = Vector3.new(pumpkinTarget.Position.X, newPos.Y, pumpkinTarget.Position.Z)
	if (lookTarget - newPos).Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(newPos, lookTarget)
	else
		root.CFrame = CFrame.new(newPos)
	end
end

