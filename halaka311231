local function refreshESP()
	espFolder:ClearAllChildren()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local list = collectPumpkins(root, char)
	local shown = 0
	for _, e in ipairs(list) do
		if shown >= 25 then break end
		shown = shown + 1
		local color = e.skipped and COLORS.AccentRed or COLORS.GlowOrange

		local h = Instance.new("Highlight")
		h.Adornee = e.inst
		h.FillColor = color
		h.FillTransparency = 0.45
		h.OutlineColor = Color3.fromRGB(255, 200, 80)
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = espFolder

		makeESPLabel(e.part, "🎃 " .. e.inst.Name .. " | " .. math.floor(e.dist) .. "m", color, 30)
	end
end

