	minimizedIcon.AnchorPoint = Vector2.new(1, 1)
	minimizedIcon.BackgroundColor3 = COLORS.Surface
	minimizedIcon.BorderSizePixel = 0
	minimizedIcon.Position = UDim2.new(1, -20, 1, -20)
	minimizedIcon.Size = UDim2.new(0, 50, 0, 50)
	minimizedIcon.Visible = false
	minimizedIcon.ZIndex = 99999
	
	local minIconCorner = Instance.new("UICorner")
	minIconCorner.CornerRadius = UDim.new(1, 0)
	minIconCorner.Parent = minimizedIcon
	
	local minIconBorder = Instance.new("UIStroke")
	minIconBorder.Color = COLORS.GlowOrange
	minIconBorder.Thickness = 2.2
	minIconBorder.Parent = minimizedIcon
	addHalloweenShimmer(minIconBorder)
	addClickEffect(minimizedIcon)
	
