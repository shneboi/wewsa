	pumpkinFace.Parent = minimizedIcon
	
	notifBadge = Instance.new("Frame")
	notifBadge.Size = UDim2.new(0, 12, 0, 12)
	notifBadge.Position = UDim2.new(1, -4, 0, -2)
	notifBadge.BackgroundColor3 = COLORS.AccentGreen
	notifBadge.BorderSizePixel = 0
	notifBadge.Visible = (currentPartner ~= nil)
	notifBadge.ZIndex = 100001
	local badgeCorner = Instance.new("UICorner")
	badgeCorner.CornerRadius = UDim.new(1, 0)
	badgeCorner.Parent = notifBadge
	local badgeStroke = Instance.new("UIStroke")
	badgeStroke.Color = Color3.fromRGB(20, 10, 30)
	badgeStroke.Thickness = 1.5
	badgeStroke.Parent = notifBadge
	notifBadge.Parent = minimizedIcon
	
	local dragging = false
	local dragStart = nil
	local startPos = nil
	
	minimizedIcon.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = minimizedIcon.Position
		end
	end)
	
	minimizedIcon.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	
	userInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			minimizedIcon.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	
	minimizeBtn.MouseButton1Click:Connect(function()
		playUISound("rbxassetid://6895079853", 1, 0.4)
		lastMainPosition = mainFrame.Position
		
		local centerOffset = UDim2.new(
			lastMainPosition.X.Scale,
			lastMainPosition.X.Offset + mainWidth / 2,
			lastMainPosition.Y.Scale,
			lastMainPosition.Y.Offset + mainHeight / 2
		)
		
		tweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = centerOffset
		}):Play()
		
		task.wait(0.2)
		mainFrame.Visible = false
		
		minimizedIcon.Visible = true
		minimizedIcon.Size = UDim2.new(0, 0, 0, 0)
		notifBadge.Visible = (currentPartner ~= nil)
		
		tweenService:Create(minimizedIcon, TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 50, 0, 50)
		}):Play()
	end)
	
	minimizedIcon.MouseButton1Click:Connect(function()
		playUISound("rbxassetid://6895079853", 1, 0.4)
		tweenService:Create(minimizedIcon, TweenInfo.new(0.15), {
			Size = UDim2.new(0, 0, 0, 0)
		}):Play()
		
		task.wait(0.15)
		minimizedIcon.Visible = false
		
		local centerOffset = UDim2.new(
			lastMainPosition.X.Scale,
			lastMainPosition.X.Offset + mainWidth / 2,
			lastMainPosition.Y.Scale,
			lastMainPosition.Y.Offset + mainHeight / 2
		)
		
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 0, 0, 0)
		mainFrame.Position = centerOffset
		
		tweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, mainWidth, 0, mainHeight),
			Position = lastMainPosition
		}):Play()
	end)
	
	exitBtn.MouseButton1Click:Connect(function()
		playUISound("rbxassetid://6895079853", 0.9, 0.4)
		autoPumpkinEnabled = false
		stopPumpkinFly()
		stopTrickOrTreat()
		tweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}):Play()
		task.wait(0.2)
		gui:Destroy()
	end)
	
	-- Entry Animation
	mainFrame.Size = UDim2.new(0, 0, 0, 0)
	mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	local entryTween = TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	tweenService:Create(mainFrame, entryTween, {Size = UDim2.new(0, mainWidth, 0, mainHeight)}):Play()
	tweenService:Create(mainFrame, entryTween, {Position = defaultPosition}):Play()
end

