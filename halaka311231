-- ========== 🍬 AUTO TRICK OR TREAT ==========
-- Gumagamit ng ProximityPrompt (ang tunay na interaction ng game). Walang hinuhulaang RemoteEvent.
local TOT_KEYWORDS = {"trick", "treat"}   -- hinahanap sa ActionText / ObjectText / pangalan ng prompt at parent nito
local TOT_FLY_SPEED = 250
local TOT_MAX_STOP_DIST = 6               -- gaano kalapit lalapit sa prompt
local TOT_COOLDOWN = 120                  -- segundo bago ulitin ang prompt na natapos na
local TOT_FAIL_COOLDOWN = 20              -- segundo bago ulitin ang prompt na pumalya
local TOT_CONFIRM_TIMEOUT = 3             -- hintay sa kumpirmasyon pagkatapos mag-interact
local TOT_TRAVEL_TIMEOUT = 40             -- max na biyahe papunta sa isang target

local totRunId = 0
local totVisited = {}                     -- [prompt] = oras kung kailan puwede ulit
local totNotifyTimes = {}

local function totActive(id)
	return trickTreatEnabled and id == totRunId and gui and gui.Parent ~= nil
end

local function totNotify(key, msg, isError, interval)
	local now = tick()
	if totNotifyTimes[key] and now - totNotifyTimes[key] < (interval or 6) then return end
	totNotifyTimes[key] = now
	task.spawn(showNotification, msg, isError)
end

local function totPromptText(prompt)
	local parts = {prompt.ActionText, prompt.ObjectText, prompt.Name}
	local par = prompt.Parent
	if par then parts[#parts+1] = par.Name end
	local model = prompt:FindFirstAncestorOfClass("Model")
	if model then parts[#parts+1] = model.Name end
	return string.lower(table.concat(parts, " "))
end

local function totMatches(prompt)
	local text = totPromptText(prompt)
	for _, kw in ipairs(TOT_KEYWORDS) do
		if string.find(text, kw, 1, true) then return true end
	end
	return false
end

local function totPromptPosition(prompt)
	local par = prompt.Parent
	if not par then return nil end
	if par:IsA("Attachment") then return par.WorldPosition end
	if par:IsA("BasePart") then return par.Position end
	if par:IsA("Model") then
		local ok, cf = pcall(function() return par:GetPivot() end)
		if ok then return cf.Position end
	end
	local anc = prompt:FindFirstAncestorWhichIsA("BasePart")
	return anc and anc.Position or nil
end

local function findTotTargets(root, char)
	local list = {}
	local now = tick()
	for _, o in ipairs(workspace:GetDescendants()) do
		if o:IsA("ProximityPrompt") and o.Enabled and not o:IsDescendantOf(char) then
			local cd = totVisited[o]
			if (not cd or now >= cd) and totMatches(o) then
				local pos = totPromptPosition(o)
				if pos then
					list[#list+1] = {prompt = o, dist = (pos - root.Position).Magnitude}
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end

-- Walang nahanap: ilista sa console lahat ng prompt para makita kung ano ang tamang keyword
local function reportNoTotTargets(root)
	local all = {}
	for _, o in ipairs(workspace:GetDescendants()) do
		if o:IsA("ProximityPrompt") then
			local pos = totPromptPosition(o)
			all[#all+1] = {prompt = o, dist = pos and (pos - root.Position).Magnitude or math.huge}
		end
	end
	table.sort(all, function(a, b) return a.dist < b.dist end)
	print("[TrickOrTreatDebug] ProximityPrompts na na-load: " .. #all)
	for i = 1, math.min(10, #all) do
		local pr = all[i].prompt
		print(string.format("[TrickOrTreatDebug] Action='%s' Object='%s' Enabled=%s %dm | %s",
			pr.ActionText, pr.ObjectText, tostring(pr.Enabled), math.floor(all[i].dist), pr:GetFullName()))
	end
	if #all > 0 then
		totNotify("none", "Walang Trick or Treat target. Tingnan ang console (TrickOrTreatDebug)", true, 10)
	else
		totNotify("none", "Walang ProximityPrompt na na-load sa paligid mo", true, 10)
	end
end

local function removeTotFly()
