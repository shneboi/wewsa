			eventWindow.Position = UDim2.new(0.5, 0, 0.5, 0)
			tweenService:Create(eventWindow, TweenInfo.new(0.3, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, EVENT_W, 0, EVENT_H),
				Position = eventOpenPos
			}):Play()
		end
	end)
	
	eCloseBtn.MouseButton1Click:Connect(function()
		playUISound("rbxassetid://6895079853", 1, 0.4)
		tweenService:Create(eventWindow, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}):Play()
		task.wait(0.2)
		eventWindow.Visible = false
	end)
	
