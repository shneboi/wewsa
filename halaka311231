	local root = char and char:FindFirstChild("HumanoidRootPart")
	local bv = root and root:FindFirstChild("TotFly")
	if bv then bv:Destroy() end
end

-- Lipad papunta sa prompt. Returns true kapag nakalapit na, o false + dahilan
local function totFlyTo(prompt, id)
	local startT = tick()
	local stopDist = math.clamp(prompt.MaxActivationDistance * 0.5, 2, TOT_MAX_STOP_DIST)
	while totActive(id) do
		local dt = runService.Heartbeat:Wait()
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health <= 0 then return false, "dead" end
		if not prompt.Parent or not prompt.Enabled then return false, "gone" end
		local pos = totPromptPosition(prompt)
		if not pos then return false, "gone" end
		if tick() - startT > TOT_TRAVEL_TIMEOUT then return false, "timeout" end

		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
		local bv = root:FindFirstChild("TotFly")
		if not bv then
			bv = Instance.new("BodyVelocity")
			bv.Name = "TotFly"
			bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
			bv.Parent = root
		end
		bv.Velocity = Vector3.zero
		root.AssemblyLinearVelocity = Vector3.zero

		local diff = pos - root.Position
		local dist = diff.Magnitude
		if dist <= stopDist then return true end

		local newPos = root.Position + diff.Unit * math.min(TOT_FLY_SPEED * dt, dist - stopDist + 0.1)
		local look = Vector3.new(pos.X, newPos.Y, pos.Z)
		if (look - newPos).Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(newPos, look)
		else
			root.CFrame = CFrame.new(newPos)
		end
	end
	return false, "stopped"
end

-- Interact sa prompt at hintayin ang kumpirmasyon (nawala / na-disable / nagbago ang text)
local function totInteract(prompt, id)
	local beforeText = prompt.ActionText
	local function changed()
		return not prompt.Parent or not prompt.Enabled or prompt.ActionText ~= beforeText
	end
	local function waitConfirm()
		local t0 = tick()
		while totActive(id) and tick() - t0 < TOT_CONFIRM_TIMEOUT do
			if changed() then return true end
			task.wait(0.1)
		end
		return changed()
	end

	if typeof(fireproximityprompt) == "function" then
		pcall(fireproximityprompt, prompt)
		if waitConfirm() then return true end
	end

	-- Backup: pindutin ang mismong key ng prompt (hold kung kailangan)
	pcall(function()
		local key = prompt.KeyboardKeyCode
		if key == Enum.KeyCode.Unknown then key = Enum.KeyCode.E end
		virtualInputManager:SendKeyEvent(true, key, false, game)
		task.wait(math.max(prompt.HoldDuration, 0) + 0.15)
		virtualInputManager:SendKeyEvent(false, key, false, game)
	end)
	return waitConfirm()
end

local function stopTrickOrTreat()
	trickTreatEnabled = false
	totRunId = totRunId + 1
	removeTotFly()
end

local function startTrickOrTreat()
	totRunId = totRunId + 1          -- pinapatay ang lumang loop, walang duplicate
	local id = totRunId
	for k in pairs(totVisited) do totVisited[k] = nil end
	trickTreatEnabled = true

	task.spawn(function()
		while totActive(id) do
			local ok, err = pcall(function()
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not root or not hum or hum.Health <= 0 then
					task.wait(1) -- hintay mag-respawn
					return
				end

				local targets = findTotTargets(root, char)
				local target = targets[1]
				if not target then
					reportNoTotTargets(root)
					task.wait(3)
					return
				end

				local prompt = target.prompt
				local label = prompt.Parent and prompt.Parent.Name or prompt.Name
				totNotify("found", "Target Found: " .. label .. " (" .. math.floor(target.dist) .. "m)", false, 4)

				local reached, why = totFlyTo(prompt, id)
				if not totActive(id) then return end
				if not reached then
					totVisited[prompt] = tick() + TOT_FAIL_COOLDOWN
					if why == "timeout" then
						totNotify("timeout", "Hindi maabot ang " .. label .. ", lilipat sa susunod", true, 8)
					end
					return
				end

				local done = totInteract(prompt, id)
				if not totActive(id) then return end
				if done then
					totVisited[prompt] = tick() + TOT_COOLDOWN
					totNotify("done", "Trick or Treat Completed: " .. label, false, 3)
				else
					totVisited[prompt] = tick() + TOT_FAIL_COOLDOWN
					totNotify("noconfirm", "Walang kumpirmasyon sa " .. label .. ", susubukan ang iba", true, 8)
				end
				task.wait(0.5)
			end)
			if not ok then
				warn("[TrickOrTreat] " .. tostring(err))
				task.wait(1)
			end
		end
	end)
end

local function setTrickOrTreat(enabled)
	if enabled then
		if autoPumpkinEnabled then
			totNotify("pause", "Auto Pumpkin Hunt naka-pause habang tumatakbo ang Trick or Treat", false, 4)
		end
		startTrickOrTreat()
	else
		stopTrickOrTreat()
		task.spawn(showNotification, "Auto Trick or Treat Disabled", false)
	end
end

