	local function detectTradePartner()
		local myChar = player.Character
		if not myChar then return nil end
		local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
		local myHum = myChar:FindFirstChildOfClass("Humanoid")
		if not myRoot or not myHum then return nil end
		local mainGui = playerGui:FindFirstChild("Main")
		if mainGui then
			local tradeGui = mainGui:FindFirstChild("Trade")
			if tradeGui and tradeGui.Visible then
				for _, obj in ipairs(tradeGui:GetDescendants()) do
					if obj:IsA("TextLabel") and obj.Visible and obj.Text ~= "" and obj.Text ~= player.Name and obj.Text ~= player.DisplayName then
						for _, p in ipairs(playersService:GetPlayers()) do
							if p ~= player then
								if obj.Text == p.Name or obj.Text == p.DisplayName or obj.Text:find(p.DisplayName, 1, true) or obj.Text:find(p.Name, 1, true) then
									return p
								end
							end
						end
					end
				end
			end
		end
		if myHum.Sit then
			local closestPlr = nil
			local closestDist = 18
			for _, otherPlr in ipairs(playersService:GetPlayers()) do
				if otherPlr ~= player and otherPlr.Character then
					local otherRoot = otherPlr.Character:FindFirstChild("HumanoidRootPart") or otherPlr.Character:FindFirstChild("Torso")
					local otherHum = otherPlr.Character:FindFirstChildOfClass("Humanoid")
					if otherRoot and otherHum then
						local dist = (otherRoot.Position - myRoot.Position).Magnitude
						if dist <= closestDist and (otherHum.Sit or dist <= 12) then
							closestDist = dist
							closestPlr = otherPlr
						end
					end
				end
			end
			if closestPlr then
				return closestPlr
			end
		end
		return nil
	end
	
