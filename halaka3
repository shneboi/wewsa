-- ========== 🔊 UI SOUND SYSTEM ==========
local function playUISound(id, pitch, vol)
	task.spawn(function()
		pcall(function()
			local s = Instance.new("Sound")
			s.SoundId = id
			s.Pitch = pitch or 1
			s.Volume = vol or 0.4
			s.Parent = soundService
			s:Play()
			task.delay(1.5, function()
				if s then s:Destroy() end
			end)
		end)
	end)
end

-- ========== 🔘 EMBER PARTICLES ==========
local function createEmberParticles(parent)
	for i = 1, 14 do
		local particle = Instance.new("Frame")
		particle.Size = UDim2.new(0, math.random(2, 4), 0, math.random(2, 4))
		particle.Position = UDim2.new(math.random(), 0, math.random(), 0)
		particle.BackgroundColor3 = (i % 2 == 0) and COLORS.GlowOrange or COLORS.AccentPurple
		particle.BackgroundTransparency = 0.4
		particle.BorderSizePixel = 0
		particle.ZIndex = 9998
		
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = particle
		particle.Parent = parent
		
		task.spawn(function()
			local speed = math.random(6, 14) / 10
			local angle = math.random() * math.pi * 2
			local moveX = math.cos(angle) * 0.0015 * speed
			local moveY = -0.002 * speed
			
			while particle and particle.Parent do
				local newX = particle.Position.X.Scale + moveX
				local newY = particle.Position.Y.Scale + moveY
				
				if newX < 0 then newX = 1 elseif newX > 1 then newX = 0 end
				if newY < 0 then newY = 1 end
				
				particle.Position = UDim2.new(newX, 0, newY, 0)
				runService.RenderStepped:Wait()
			end
		end)
	end
end

-- ========== 🦇 FLYING BATS BACKGROUND ANIMATION ==========
local function createFlyingBats(parent)
	local batLayer = Instance.new("Frame")
	batLayer.Name = "BatLayer"
	batLayer.Size = UDim2.new(1, 0, 1, 0)
	batLayer.BackgroundTransparency = 1
	batLayer.ClipsDescendants = true
	batLayer.ZIndex = 9998
	batLayer.Parent = parent

	local function spawnBat()
		if not parent or not parent.Parent then return end
		local bat = Instance.new("TextLabel")
		bat.Size = UDim2.new(0, 20, 0, 20)
		local startY = math.random(15, 75) / 100
		bat.Position = UDim2.new(-0.12, 0, startY, 0)
		bat.BackgroundTransparency = 1
		bat.Text = "🦇"
		bat.TextSize = math.random(13, 17)
		bat.TextColor3 = (math.random(1, 2) == 1) and COLORS.AccentPurple or COLORS.GlowOrangeDim
		bat.TextTransparency = math.random(35, 60) / 100
		bat.ZIndex = 9998
		bat.Parent = batLayer

		-- Flapping wings effect
		local flapScale = Instance.new("UIScale")
		flapScale.Parent = bat
		task.spawn(function()
			while bat and bat.Parent do
				tweenService:Create(flapScale, TweenInfo.new(0.14, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Scale = 0.7}):Play()
				task.wait(0.14)
				if not bat or not bat.Parent then break end
				tweenService:Create(flapScale, TweenInfo.new(0.14, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Scale = 1.0}):Play()
				task.wait(0.14)
			end
		end)

		-- Flight Path: swooping across the window
		local flightTime = math.random(45, 75) / 10
		local endY = math.clamp(startY + (math.random(-20, 20) / 100), 0.1, 0.85)
		local flightTween = tweenService:Create(bat, TweenInfo.new(flightTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			Position = UDim2.new(1.15, 0, endY, 0)
		})
		flightTween:Play()
		flightTween.Completed:Connect(function()
			bat:Destroy()
		end)
	end

	task.spawn(function()
		while parent and parent.Parent do
			spawnBat()
			task.wait(math.random(25, 45) / 10)
		end
	end)
end

