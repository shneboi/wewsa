-- ========== ⚡ TACTILE TOUCH FEEDBACK ==========
local function addClickEffect(button)
	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = button
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			tweenService:Create(scale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.94}):Play()
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			tweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.0}):Play()
		end
	end)
end

-- ========== 💫 HALLOWEEN SHIMMER BORDER ==========
local function addHalloweenShimmer(stroke)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 50, 10)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 170, 40)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(150, 60, 220)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 50, 10))
	})
	gradient.Parent = stroke
	task.spawn(function()
		local rot = 0
		while stroke and stroke.Parent do
			rot = (rot + 2.5) % 360
			gradient.Rotation = rot
			task.wait(0.03)
		end
	end)
end

