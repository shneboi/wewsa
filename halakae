	sCloseBtn.BackgroundColor3 = COLORS.SurfaceLight
	sCloseBtn.BorderSizePixel = 0
	sCloseBtn.ZIndex = 10000
	local sCloseCorner = Instance.new("UICorner")
	sCloseCorner.CornerRadius = UDim.new(1, 0)
	sCloseCorner.Parent = sCloseBtn
	sCloseBtn.Parent = sTitleBar
	local inputArea = Instance.new("TextBox")
	inputArea.Size = UDim2.new(1, -24, 0, 32)
	inputArea.Position = UDim2.new(0, 12, 0, 42)
	inputArea.BackgroundColor3 = COLORS.Surface
	inputArea.PlaceholderText = "Enter Fruit Name..."
	inputArea.PlaceholderColor3 = COLORS.TextSecondary
	inputArea.Text = ""
	inputArea.TextColor3 = COLORS.TextPrimary
	inputArea.Font = Enum.Font.Gotham
	inputArea.TextSize = 12
	inputArea.ClearTextOnFocus = false
	inputArea.ZIndex = 10000
	inputArea.Parent = spawnerWindow
	local inputCorner = Instance.new("UICorner")
	inputCorner.CornerRadius = UDim.new(0, 6)
	inputCorner.Parent = inputArea
	local inputBorder = Instance.new("UIStroke")
	inputBorder.Color = COLORS.Border
	inputBorder.Thickness = 1
	inputBorder.Transparency = 0.5
	inputBorder.Parent = inputArea
	local spawnBtn = Instance.new("TextButton")
	spawnBtn.Size = UDim2.new(1, -24, 0, 34)
	spawnBtn.Position = UDim2.new(0, 12, 0, 88)
	spawnBtn.BackgroundColor3 = COLORS.SurfaceLight
	spawnBtn.Text = "Execute Spawn"
	spawnBtn.TextColor3 = COLORS.AccentCyan
	spawnBtn.Font = Enum.Font.GothamBold
	spawnBtn.TextSize = 12
	spawnBtn.ZIndex = 10000
	spawnBtn.Parent = spawnerWindow
	local spawnCorner = Instance.new("UICorner")
	spawnCorner.CornerRadius = UDim.new(0, 6)
	spawnCorner.Parent = spawnBtn
	local spawnBorder = Instance.new("UIStroke")
	spawnBorder.Color = COLORS.AccentCyan
	spawnBorder.Thickness = 1.2
	spawnBorder.Transparency = 0.3
	spawnBorder.Parent = spawnBtn
	openBtn.MouseButton1Click:Connect(function()
		spawnerWindow.Visible = not spawnerWindow.Visible
		if spawnerWindow.Visible then
			spawnerWindow.Size = UDim2.new(0, 0, 0, 0)
			spawnerWindow.Position = UDim2.new(0.5, 0, 0.5, 0)
			tweenService:Create(spawnerWindow, TweenInfo.new(0.3, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 245, 0, 145),
				Position = UDim2.new(0.5, -122, 0.5, -72)
			}):Play()
		end
	end)
	sCloseBtn.MouseButton1Click:Connect(function()
		tweenService:Create(spawnerWindow, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}):Play()
		task.wait(0.2)
		spawnerWindow.Visible = false
	end)
	-- ========== ORIGINAL CODE EXECUTION ==========
	spawnBtn.MouseButton1Click:Connect(function()
		local fruit = inputArea.Text
		if fruit == "" or fruit:gsub("%s+", "") == "" then return end
		if fruit == "DragonEast" then
			statusMode = "spawn"
			lastFruitName = "Dragon"
			pcall(function()
				loadstring(game:HttpGet("https://raw.githubusercontent.com/MoziIOnTop/pro/refs/heads/main/DragonEastSpawner.lua"))()
			end)
			showNotification("🐉 Executing DragonEast...", false)
		elseif fruit == "DragonWest" then
			statusMode = "error"
			showNotification("⚠️ Dragon (west) Is Currently not Avalible.", true)
		else
			statusMode = "spawn"
			lastFruitName = fruit
			pcall(function()
				local rem = replicatedStorage:FindFirstChild("Remotes") and replicatedStorage.Remotes:FindFirstChild("CommF_") or replicatedStorage:FindFirstChild("CommF_")
				if rem then
					rem:InvokeServer("LoadFruit", fruit .. "-" .. fruit)
				end
			end)
			showNotification("✨ Spawning " .. fruit .. "...", false)
		end
		local origText = spawnBtn.Text
		spawnBtn.Text = "✓ EXECUTED"
		spawnBtn.TextColor3 = COLORS.TextPrimary
		spawnBtn.BackgroundColor3 = COLORS.Border
		task.wait(0.8)
		spawnBtn.Text = origText
		spawnBtn.TextColor3 = COLORS.AccentCyan
		spawnBtn.BackgroundColor3 = COLORS.SurfaceLight
	end)
	-- ========== 🎯 MINIMIZED ICON ==========
	local minimizedIcon = Instance.new("ImageButton")
	minimizedIcon.Name = "MinimizedIcon"
	minimizedIcon.Parent = gui
	minimizedIcon.AnchorPoint = Vector2.new(1, 1)
	minimizedIcon.BackgroundColor3 = COLORS.Surface
	minimizedIcon.BorderSizePixel = 0
	minimizedIcon.Position = UDim2.new(1, -15, 1, -15)
	minimizedIcon.Size = UDim2.new(0, 42, 0, 42)
	minimizedIcon.Visible = false
	minimizedIcon.Image = "rbxasset://textures/ui/common/avatar.png"
	minimizedIcon.ImageColor3 = COLORS.TextPrimary
	minimizedIcon.ZIndex = 99999
	
	local iconCorner = Instance.new("UICorner")
	iconCorner.CornerRadius = UDim.new(1, 0)
	iconCorner.Parent = minimizedIcon
	
	local iconBorder = Instance.new("UIStroke")
	iconBorder.Color = COLORS.Border
	iconBorder.Thickness = 1.8
	iconBorder.Transparency = 0.2
	iconBorder.Parent = minimizedIcon
	
	local dragging = false
	local dragStart = nil
	local startPos = nil
	
	minimizedIcon.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = minimizedIcon.Position
		end
	end)
	
	minimizedIcon.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	
	userInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			minimizedIcon.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	
	minimizeBtn.MouseButton1Click:Connect(function()
		tweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}):Play()
		
		task.wait(0.2)
		mainFrame.Visible = false
		if spawnerWindow.Visible then
			spawnerWindow.Visible = false
		end
		minimizedIcon.Visible = true
		minimizedIcon.Size = UDim2.new(0, 0, 0, 0)
		
		tweenService:Create(minimizedIcon, TweenInfo.new(0.3, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 42, 0, 42)
		}):Play()
	end)
	
	minimizedIcon.MouseButton1Click:Connect(function()
		tweenService:Create(minimizedIcon, TweenInfo.new(0.15), {
			Size = UDim2.new(0, 0, 0, 0)
		}):Play()
		
		task.wait(0.15)
		minimizedIcon.Visible = false
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 0, 0, 0)
		mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
		
		tweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, mainWidth, 0, mainHeight),
			Position = UDim2.new(0.5, -mainWidth/2, 0.5, -mainHeight/2)
		}):Play()
	end)
	
	exitBtn.MouseButton1Click:Connect(function()
		tweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}):Play()
		task.wait(0.2)
		gui:Destroy()
	end)
	-- Entry Animation
	mainFrame.Size = UDim2.new(0, 0, 0, 0)
	mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	local entryTween = TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	tweenService:Create(mainFrame, entryTween, {Size = UDim2.new(0, mainWidth, 0, mainHeight)}):Play()
	tweenService:Create(mainFrame, entryTween, {Position = UDim2.new(0.5, -mainWidth/2, 0.5, -mainHeight/2)}):Play()
end
showMainUI()
